---
const { summary, location, description, start, end } = Astro.props;
import { format } from "date-fns";
import { formatInTimeZone } from "date-fns-tz";

const TIMEZONE = "America/Los_Angeles";

function formatTimeRange(start, end) {
  const startTime = formatInTimeZone(new Date(start), TIMEZONE, "h:mm a");
  const endTime = formatInTimeZone(new Date(end), TIMEZONE, "h:mm a");
  return `${startTime} - ${endTime}`;
}

function formatDate(date) {
  return formatInTimeZone(new Date(date), TIMEZONE, "MMMM do");
}
---

<article
  class="group relative flex flex-col md:flex-row bg-[#1a1a1a] border border-white/5 rounded-2xl overflow-hidden hover:border-white/10 hover:bg-[#222] transition-all duration-300 shadow-lg"
>
  <div
    class="w-full md:w-64 h-48 md:h-auto bg-linear-to-br from-indigo-900 to-purple-900 flex items-center justify-center shrink-0"
  >
    <span class="text-4xl">🎮</span>
  </div>

  <div class="flex-1 p-6 flex flex-col justify-between">
    <div
      class="flex flex-col md:flex-row md:items-start md:justify-between gap-4"
    >
      <div class="space-y-2">
        <h3
          class="text-2xl font-bold font-funnel text-white group-hover:text-blue-400 transition-colors"
        >
          {summary}
        </h3>

        {
          location && (
            <p class="text-[#4ADE80] font-mono text-sm font-semibold tracking-wide">
              {location}
            </p>
          )
        }

        <p
          class="text-gray-400 text-sm line-clamp-2 md:line-clamp-3 mt-2 max-w-xl"
        >
          {description}
        </p>
      </div>

      <div class="text-left md:text-right shrink-0">
        <div class="text-xl font-funnel font-semibold text-gray-200">
          {format(new Date(start), "MMMM do")}
        </div>
        <div class="text-sm text-gray-400 font-mono mt-1">
          {formatTimeRange(start, end)}
        </div>
      </div>
    </div>

    <div
      class="hidden md:block mt-4 md:mt-0 md:absolute md:bottom-6 md:right-6 opacity-0 group-hover:opacity-100 transition-opacity"
    >
      <span
        class="text-xs font-bold uppercase tracking-wider text-blue-400 bg-blue-400/10 px-3 py-1 rounded-full"
      >
        Event Details
      </span>
    </div>
  </div>
</article>
