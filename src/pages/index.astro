---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <!-- NOTE: placholder until we get real art -->
  <div class="w-full md:hidden">
    <div class="h-48 md:h-96 overflow-hidden">
      <img
        src="https://placehold.co/3840x2160"
        class="w-full h-full object-cover"
      />
    </div>
  </div>

  <div class="w-full max-w-5xl mx-auto py-28 md:pt-40">
    <div class="text-center flex group flex-col space-y-3 overflow-hidden">
      <h1
        class="text-5xl md:text-8xl font-extrabold font-funnel bg-linear-to-l from-slate-900 to-gray-400 bg-clip-text text-transparent"
      >
        Video Game Development Club
      </h1>
      <span
        class="text-5xl duration-500 group-hover:skew-x-[-10deg] font-semibold font-funnel text-orange-400"
        >@ CSUF</span
      >
    </div>
  </div>

  <!-- NOTE: placeholder until we get real art -->
  <div class="w-full hidden md:block py-40">
    <div class="h-48 md:h-96 overflow-hidden">
      <img
        src="https://placehold.co/3840x2160"
        class="w-full h-full object-cover"
      />
    </div>
  </div>

  <div
    class="grid place-self-center w-full space-y-8 place-content-center grid-cols-1 md:grid-cols-2 pb-40 max-w-5xl"
  >
    <h2
      class="text-5xl md:text-8xl self-center md:text-left text-center font-bold font-funnel"
    >
      Our Mission
    </h2>
    <p class="self-center md:px-0 px-6 font-funnel md:text-left text-center">
      At VGDC, we turn players into creators. We provide a collaborative hub for
      students of all disciplines to apply their unique skills, build
      professional portfolios, and develop innovative games. Whether you code,
      draw, write, or compose, our mission is to help you find your team and
      create something extraordinary.
    </p>
  </div>

  <div
    class="grid place-self-center w-full place-content-center grid-cols-1 md:grid-cols-2 pb-40 max-w-5xl"
  >
    <div class="hidden md:flex flex-row group items-center space-x-2">
      <div class="text-8xl animate-chomp">
        <i
          class="fas fa-dice duration-500 group-hover:rotate-180 group-hover:text-yellow-300"
        ></i>
      </div>
      <span class="leading-tight font-bold">
        <span class="font-arcade text-6xl">VGDC</span>
        <br />
        <span
          class="font-funnel text-blue-500 group-hover:text-blue-400 text-3xl italic"
          >@CSUF
        </span>
      </span>
    </div>
    <div class="space-y-8">
      <h3 class="text-4xl mb-6 text-center font-arcade">FAQ</h3>
      <!-- TODO: Replace hover with button toggle -->
      <ul class="space-y-4 md:px-0 px-4">
        <li class="w-full pb-2 group border-b-2 border-b-white">
          <div
            class="flex flex-row justify-between align-middle text-lg w-full"
          >
            <span class="font-funnel max-w-lg">How do I get involved?</span>
            <i
              class="fa-solid fa-angle-down place-self-center"
              aria-hidden="true"></i>
          </div>
          <p class="max-w-md md:px-0 px-6 mt-2 hidden group-hover:flex">
            Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do
            eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim
            ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut
            aliquip ex ea commodo consequat.
          </p>
        </li>
        <li class="w-full pb-2 group border-b-2 border-b-white">
          <div
            class="flex flex-row justify-between align-middle text-lg w-full"
          >
            <span class="font-funnel">I've never made games before... </span>
            <i
              class="fa-solid fa-angle-down place-self-center"
              aria-hidden="true"></i>
          </div>
          <p class="max-w-md mt-2 hidden group-hover:flex">
            Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do
            eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim
            ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut
            aliquip ex ea commodo consequat.
          </p>
        </li>
        <li class="w-full pb-2 group border-b-2 border-b-white">
          <div
            class="flex flex-row justify-between align-middle text-lg w-full"
          >
            <span class="font-funnel"
              >I've made a lot of games, how can VGDC help me?</span
            >
            <i
              class="fa-solid fa-angle-down place-self-center"
              aria-hidden="true"></i>
          </div>
          <p class="max-w-md mt-2 hidden group-hover:flex">
            Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do
            eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim
            ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut
            aliquip ex ea commodo consequat.
          </p>
        </li>
      </ul>
    </div>
  </div>
</Layout>
