---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div class="w-full">
    <div class="h-48 md:h-96 overflow-hidden">
      <img
        src="https://placehold.co/3840x2160"
        class="w-full h-full object-cover"
      />
    </div>
  </div>

  <div class="w-full max-w-5xl mx-auto px-8 py-10">
    <div class="text-center flex flex-col space-y-3 overflow-hidden">
      <span
        class="text-5xl md:text-8xl font-extrabold font-funnel bg-linear-to-l from-slate-900 to-gray-400 bg-clip-text text-transparent"
        >Video Game Development Club</span
      >
      <span class="text-4xl font-semibold font-funnel text-orange-400"
        >@ CSUF</span
      >
    </div>
  </div>
</Layout>
